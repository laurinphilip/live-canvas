{
  "name": "live-canvas",
  "version": "1.4.0",
  "description": "Offline Obsidian community plugin that continuously synchronizes a native, editable Canvas.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node scripts/test.mjs",
    "check": "npm run test && npm run build",
    "package": "npm run check && node scripts/package-release.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "canvas",
    "knowledge-graph",
    "visual-notes",
    "offline-first"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.8.0"
  }
}
